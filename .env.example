# 复制为 .env 后填写；只能在本机保存真实密钥。
OPENAI_API_KEY=replace-with-your-key

# 密码与数据库连接地址保持一致，postgres 是容器服务名。
POSTGRES_DB=deerflow
POSTGRES_USER=deerflow
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://deerflow:replace-with-a-strong-password@postgres:5432/deerflow

# 当前部署使用宿主机的 Redis，需自行启动并限制网络访问。
DEER_FLOW_STREAM_BRIDGE_REDIS_URL=redis://host.docker.internal:6379/0

# 当前构建需安装数据库驱动与文档转换扩展。
UV_EXTRAS=postgres pymupdf

# 登录签名密钥需长期保留；正式使用前设置足够长的随机字符串。
# AUTH_JWT_SECRET=replace-with-a-long-random-secret

# 仅在启用对应搜索工具时填写。
# SERPER_API_KEY=replace-with-your-key
# TAVILY_API_KEY=replace-with-your-key
# JINA_API_KEY=replace-with-your-key
# INFOQUEST_API_KEY=replace-with-your-key
# FIRECRAWL_API_KEY=replace-with-your-key

# Langfuse 默认关闭；启用时填写同一项目的凭据及所属区域地址。
LANGFUSE_TRACING=false
# LANGFUSE_PUBLIC_KEY=replace-with-your-public-key
# LANGFUSE_SECRET_KEY=replace-with-your-secret-key
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# LangSmith 默认关闭，可与 Langfuse 同时启用。
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-with-your-key
# LANGSMITH_PROJECT=deer-flow-learning
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 外部消息渠道只在启用相关集成时填写。
# FEISHU_APP_ID=replace-with-your-id
# FEISHU_APP_SECRET=replace-with-your-secret
# SLACK_BOT_TOKEN=replace-with-your-token
# SLACK_APP_TOKEN=replace-with-your-token
# TELEGRAM_BOT_TOKEN=replace-with-your-token
# DISCORD_BOT_TOKEN=replace-with-your-token
# WECOM_BOT_ID=replace-with-your-id
# WECOM_BOT_SECRET=replace-with-your-secret
# DINGTALK_CLIENT_ID=replace-with-your-id
# DINGTALK_CLIENT_SECRET=replace-with-your-secret

# 统一入口无需跨源配置，以下变量仅供特殊部署使用。
# GATEWAY_CORS_ORIGINS=http://localhost:2026
# GATEWAY_ENABLE_DOCS=false
# DEER_FLOW_INTERNAL_AUTH_TOKEN=replace-with-a-shared-internal-token
# CODEX_AUTH_PATH=/path/to/codex/auth.json
