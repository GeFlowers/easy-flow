# 文本文件统一使用换行符 LF。
* text=auto eol=lf

# 命令脚本与构建命令文件必须使用 LF。
*.sh text eol=lf
Makefile text eol=lf
**/Makefile text eol=lf

# 常见配置与源码文件
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.env text eol=lf

# Windows 脚本使用 CRLF。
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源不转换换行符。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.mp4 binary
*.mov binary
*.woff binary
*.woff2 binary
